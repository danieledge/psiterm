; PsiWeb 0.54 installer for Psion Series 5mx (EPOC R5)
; PsiWeb.app: screen, menus, settings.  psiweb.exe: NetSurf (the browser).
&EN
; Two-digit versions from 0.54 on (as PsiTerm and PsiMail): the EPOC
; installer compares major.minor only, so 0,5,3 looked the same as any 0,5,x.
#{"PsiWeb"},(0x01000A7A),0,54,0
"psiweb.app"-"!:\System\Apps\PsiWeb\PsiWeb.app"
"psiweb.rsc"-"!:\System\Apps\PsiWeb\PsiWeb.rsc"
"psiweb.aif"-"!:\System\Apps\PsiWeb\PsiWeb.aif"
"psiweb.mbm"-"!:\System\Apps\PsiWeb\PsiWeb.mbm"
"psiweb.exe"-"!:\System\Apps\PsiWeb\psiweb.exe"
"COPYING.txt"-"!:\System\Apps\PsiWeb\COPYING.txt"
; the EPOC C library (ESTLIB.DLL), which the engine needs and the 5mx ROM lacks
@"STDLIB.SIS",(0x100002c3)
