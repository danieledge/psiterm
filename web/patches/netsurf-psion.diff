+#ifdef PSIWEB
+/* menu commands from PsiWeb.app */
+static void psiweb_commands(void)
+{
+	char arg[512];
+	struct gui_window *gw = window_list;
+	struct browser_window *bw;
+	nsurl *url = NULL;
+	int cmd = pwb_take_command(arg, sizeof(arg));
+
+	if (cmd == PW_CMD_NONE)
+		return;
+	if (cmd == PW_CMD_QUIT) {
+		fb_complete = true;
+		return;
+	}
+	if (gw == NULL)
+		return;
+	bw = gw->bw;
+
+	switch (cmd) {
+	case PW_CMD_HOME:
+		snprintf(arg, sizeof(arg), "%s", pwb_home_url());
+		/* fall through */
+	case PW_CMD_OPEN:
+		if (search_web_omni(arg, SEARCH_WEB_OMNI_NONE, &url) == NSERROR_OK) {
+			browser_window_navigate(bw, url, NULL, BW_NAVIGATE_HISTORY,
+					NULL, NULL, NULL);
+			nsurl_unref(url);
+		}
+		break;
+	case PW_CMD_BACK:
+		if (browser_window_back_available(bw))
+			browser_window_history_back(bw, false);
+		fb_update_back_forward(gw);
+		break;
+	case PW_CMD_FORWARD:
+		if (browser_window_forward_available(bw))
+			browser_window_history_forward(bw, false);
+		fb_update_back_forward(gw);
+		break;
+	case PW_CMD_RELOAD:
+		browser_window_reload(bw, true);
+		break;
+	case PW_CMD_STOP:
+		browser_window_stop(bw);
+		break;
+	case PW_CMD_ZOOM:
+		if (atoi(arg) >= 30 && atoi(arg) <= 300)
+			browser_window_set_scale(bw, atoi(arg) / 100.0f, true);
+		break;
+	case PW_CMD_TOP:
+		widget_scroll_y(gw, 0, true);
+		break;
+	case PW_CMD_BOTTOM:
+		widget_scroll_y(gw, 0x3fffffff, true);
+		break;
+	case PW_CMD_PAGEUP:
+		widget_scroll_y(gw, -fbtk_get_height(gw->browser), false);
+		break;
+	case PW_CMD_PAGEDOWN:
+		widget_scroll_y(gw, fbtk_get_height(gw->browser), false);
+		break;
+	case PW_CMD_IMAGES:
+		nsoption_set_bool(foreground_images, arg[0] == '1');
+		nsoption_set_bool(background_images, arg[0] == '1');
+		break;
+	default:
+		break;
+	}
+}
+#endif
