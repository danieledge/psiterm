+/* The first byte from p on that is uu or 0, or eof. Attribute values
+   (class lists, SVG paths, srcset) are most of a modern page's tags, and
+   are scanned several times: this looks at a word at a time. */
+#define PSI_ONES 0x01010101UL
+#define PSI_HIGHS 0x80808080UL
+/* (gcc 3.0 would build both constants afresh in every turn of the loop,
+   8 instructions a word: the empty asm makes it keep them in registers) */
+#ifdef __GNUC__
+#define PSI_KEEP(x) __asm__("" : "=r"(x) : "0"(x))
+#else
+#define PSI_KEEP(x) do { } while (0)
+#endif
+#define PSI_HASZERO(v) (((v) - ones) & ~(v) & highs)
+static inline unsigned char *psi_scan_quote(unsigned char *p, unsigned char *eof, unsigned char uu)
+{
+	unsigned long m = uu * PSI_ONES, v, x, ones = PSI_ONES, highs = PSI_HIGHS;
+	PSI_KEEP(ones);
+	PSI_KEEP(highs);
+	while (p < eof && ((unsigned long)p & 3)) {
+		if (*p == uu || !*p) return p;
+		p++;
+	}
+	while (eof - p >= 4) {
+		v = *(unsigned long *)p;
+		x = v ^ m;
+		if (PSI_HASZERO(v) | PSI_HASZERO(x)) break;
+		p += 4;
+	}
+	while (p < eof) {
+		if (*p == uu || !*p) return p;
+		p++;
+	}
+	return p;
+}
+
+/* the same, with no end but the 0 byte (as get_attr_val's own loops) */
+static inline unsigned char *psi_scan_quote0(unsigned char *p, unsigned char uu)
+{
+	unsigned long m = uu * PSI_ONES, v, x, ones = PSI_ONES, highs = PSI_HIGHS;
+	PSI_KEEP(ones);
+	PSI_KEEP(highs);
+	while ((unsigned long)p & 3) {
+		if (*p == uu || !*p) return p;
+		p++;
+	}
+	for (;; p += 4) {
+		v = *(unsigned long *)p;
+		x = v ^ m;
+		if (PSI_HASZERO(v) | PSI_HASZERO(x)) break;
+	}
+	while (*p != uu && *p) p++;
+	return p;
+}
+#endif
