+int psi_sock_connect(unsigned char *host, int port, int tls, unsigned char **why);
+
+static void psi_make_connection(struct connection *c, int port, int *sock, void (*func)(struct connection *))
+{
+	unsigned char *host, *why = NULL;
+	int s, tls;
+	if (!(host = get_host_name(c->url))) {
+		setcstate(c, S_INTERNAL);
+		abort_connection(c);
+		return;
+	}
+	tls = !is_proxy_url(c->url) && !casecmp(c->url, cast_uchar "https://", 8);
+	setcstate(c, S_CONN);
+	s = psi_sock_connect(host, port, tls, &why);
+	mem_free(host);
+	if (s < 0) {
+		if (why) mem_free(why);
+		setcstate(c, tls ? S_SSL_ERROR : get_error_from_errno(ECONNREFUSED));
+		retry_connection(c);
+		return;
+	}
+	*sock = s;
+	set_connection_timeout(c);
+	func(c);
+}
+#endif
