+#ifdef PSI_JPEG_SCALE
+		if (!global_cinfo->scale_denom || global_cinfo->scale_num == global_cinfo->scale_denom) {
+			/* PsiWeb: decode straight to (nearly) the size shown.
+			 * libjpeg 7+ scales by n/8 in the IDCT, so a 1600-wide
+			 * photo shown 320 wide is decoded 400 wide: 1/16 of the
+			 * memory and much less work for the scaler. Pictures with
