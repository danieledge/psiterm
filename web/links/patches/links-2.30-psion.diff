 int get_attr_val_nl = 0;
 
+#ifdef PSIWEB
+/* A memo of where each attribute of one element starts. parse_html and
+   the element's handler ask for several attributes of the same element
+   (id, style, class, href, ...), and each get_attr_val call used to scan
+   all of its attributes again: on a modern page, long class lists, SVG
+   paths and srcsets were scanned five or six times. The memo is only used
+   for the element parse_html is handling (amemo_scope), and is rebuilt for
+   each new one, so it never outlives the document it points into. With
+   it, get_attr_val goes straight to the attribute asked for, or returns
+   NULL at once; what it returns is exactly what the full scan returns. */
+#define PSI_AMEMO 40
+static unsigned char *amemo_scope;	/* the element being handled */
+static unsigned char *amemo_e;		/* the attributes the memo is for */
+static int amemo_n;			/* entries */
+static int amemo_ok;			/* 1: every attribute is in it */
+static unsigned char *amemo_at[PSI_AMEMO];	/* where each one starts */
+static int amemo_len[PSI_AMEMO];	/* the length of its name */
+
+static void amemo_build(unsigned char *e)
+{
+	unsigned char *p = e, *q, c;
+	amemo_e = e;
+	amemo_n = 0;
+	amemo_ok = 0;
+	for (;;) {
+		q = p;
+		while (WHITECHAR(*p)) p++;
+		if (*p == '>' || *p == '<') break;
+		if (amemo_n == PSI_AMEMO) return;	/* (too many: not used) */
+		amemo_at[amemo_n] = p;
+		while (atchr(*p)) p++;
+		amemo_len[amemo_n] = (int)(p - amemo_at[amemo_n]);
+		amemo_n++;
+		while (WHITECHAR(*p)) p++;
+		if (*p == '=') {
+			p++;
+			while (WHITECHAR(*p)) p++;
+			if (!U(*p)) {
+				while (!WHITECHAR(*p) && *p != '>' && *p != '<') p++;
+			} else {
+				c = *p;
+				p = psi_scan_quote0(p + 1, c);
+				if (!*p) break;		/* (get_attr_val stops here too) */
+				p++;
+			}
+		}
+		if (p == q) return;	/* (not a tag parse_element accepted) */
+	}
+	amemo_ok = 1;
+}
+#endif
