RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF { buf=""; }

RESOURCE EIK_APP_INFO
	{
	menubar=r_pw_menubar;
	hotkeys=r_pw_hotkeys;
	toolbar=r_pw_toolbar;
	}

// The standard toolbar: the program's name, four buttons for the pen (Open
// an address, Back, the Home page, Zoom - which cycles the sizes), the
// clock. The pictures come from PsiWeb.mbm (web/tools/mkicons.py):
// CPwAppUi::ConstructL puts them on. View > Show toolbar (Ctrl+T) hides it
// and the page takes its room.
RESOURCE TOOLBAR r_pw_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiWeb"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=EPwCmdOpen; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Open"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdBack; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Back"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdHome; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Home"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdZoomIn; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Zoom"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// Shortcuts: EIKON's standard letters for the standard commands (Ctrl+E
// close, Ctrl+O open, Ctrl+M / Shift+Ctrl+M zoom, Ctrl+T toolbar, Ctrl+K
// preferences, Shift+Ctrl+A about), the built-in Email program's Ctrl+U
// (disconnect) and Shift+Ctrl+Q (status information = Page info), and the
// browser's own: Ctrl+L also opens an address, Ctrl+H home, Ctrl+R reload,
// Ctrl+B back, Ctrl+F forward, Ctrl+I images. Ctrl+A/C/V/X/Z stay with the
// page (select all, copy, paste...); Esc stops a page loading.
RESOURCE HOTKEYS r_pw_hotkeys
	{
	control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=EPwCmdOpen; key='o'; },
		HOTKEY { command=EPwCmdOpen; key='l'; },
		HOTKEY { command=EPwCmdHome; key='h'; },
		HOTKEY { command=EPwCmdReload; key='r'; },
		HOTKEY { command=EPwCmdBack; key='b'; },
		HOTKEY { command=EPwCmdForward; key='f'; },
		HOTKEY { command=EPwCmdZoomIn; key='m'; },
		HOTKEY { command=EPwCmdImages; key='i'; },
		HOTKEY { command=EPwCmdToggleToolbar; key='t'; },
		HOTKEY { command=EPwCmdPrefs; key='k'; },
		HOTKEY { command=EPwCmdHangup; key='u'; }
		};
	shift_control=
		{
		HOTKEY { command=EPwCmdZoomOut; key='m'; },
		HOTKEY { command=EPwCmdPageInfo; key='q'; },
		HOTKEY { command=EPwCmdAbout; key='a'; }
		};
	}

// Menus in EIKON's order: File, View, the program's own (Go), then Tools
// ending with About
RESOURCE MENU_BAR r_pw_menubar
	{
	titles=
		{
		MENU_TITLE { menu_pane=r_pw_file_menu; txt="File"; },
		MENU_TITLE { menu_pane=r_pw_view_menu; txt="View"; },
		MENU_TITLE { menu_pane=r_pw_go_menu; txt="Go"; },
		MENU_TITLE { menu_pane=r_pw_tools_menu; txt="Tools"; }
		};
	}

// File: the page, the connection, Close. Stop has no letter shortcut: Esc
// stops a page loading, as in the built-in programs
RESOURCE MENU_PANE r_pw_file_menu
	{
	items=
		{
		MENU_ITEM { command=EPwCmdOpen; txt="Open address..."; },
		MENU_ITEM { command=EPwCmdHome; txt="Home page"; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdReload; txt="Reload"; },
		MENU_ITEM { command=EPwCmdStop; txt="Stop"; extratxt="Esc"; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdHangup; txt="Disconnect"; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EEikCmdExit; txt="Close"; }
		};
	}

// View: zoom (in and out cycle round the sizes), the tick boxes, then
// Page info (the Email program's Status information, on its key)
RESOURCE MENU_PANE r_pw_view_menu
	{
	items=
		{
		MENU_ITEM { command=EPwCmdZoomIn; txt="Zoom in"; },
		MENU_ITEM { command=EPwCmdZoomOut; txt="Zoom out"; },
		MENU_ITEM { command=EPwCmdZoomNormal; txt="Normal size"; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdToggleToolbar; txt="Show toolbar"; flags=EEikMenuItemCheckBox; },
		MENU_ITEM { command=EPwCmdImages; txt="Show pictures"; flags=EEikMenuItemCheckBox|EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdPageInfo; txt="Page information..."; }
		};
	}

RESOURCE MENU_PANE r_pw_go_menu
	{
	items=
		{
		MENU_ITEM { command=EPwCmdBack; txt="Back"; },
		MENU_ITEM { command=EPwCmdForward; txt="Forward"; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdTop; txt="Top of page"; },
		MENU_ITEM { command=EPwCmdBottom; txt="End of page"; }
		};
	}

// Tools: preferences and settings, the engine, updates, About last
RESOURCE MENU_PANE r_pw_tools_menu
	{
	items=
		{
		MENU_ITEM { command=EPwCmdPrefs; txt="Preferences..."; },
		MENU_ITEM { command=EPwCmdConnSettings; txt="Connection settings..."; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdRestart; txt="Restart browser engine"; },
		MENU_ITEM { command=EPwCmdUpdate; txt="Update PsiWeb..."; flags=EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command=EPwCmdAbout; txt="About PsiWeb"; }
		};
	}

RESOURCE DIALOG r_pw_open_dialog
	{
	title="Open address";
	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtEdwin; prompt="Address"; id=EPwDlgUrl;
			control=EDWIN { width=30; maxlength=500; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="Or words to search for"; }; }
		};
	}

RESOURCE DIALOG r_pw_conn_dialog
	{
	title="Connection settings";
	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="Connect via"; id=EPwDlgLink; control=CHOICELIST { array_id=r_pw_link_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Baud rate"; id=EPwDlgBaud; control=CHOICELIST { array_id=r_pw_baud_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Flow control"; id=EPwDlgFlow; control=CHOICELIST { array_id=r_pw_flow_array; }; },
		DLG_LINE { type=EEikCtEdwin; prompt="Psion Internet: first send"; id=EPwDlgPppStart; control=EDWIN { width=14; maxlength=40; }; }
		};
	}

// Preferences (Ctrl+K): the home page and the proxy. The connection itself
// is in Connection settings (shared with PsiTerm and PsiMail).
RESOURCE DIALOG r_pw_prefs_dialog
	{
	title="Preferences";
	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtEdwin; prompt="Home page"; id=EPwDlgHome; control=EDWIN { width=24; maxlength=200; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Use a proxy"; id=EPwDlgProxy; control=CHOICELIST { array_id=r_pw_proxy_array; }; },
		DLG_LINE { type=EEikCtEdwin; prompt="Proxy host"; id=EPwDlgProxyHost; control=EDWIN { width=24; maxlength=60; }; },
		DLG_LINE { type=EEikCtNumberEditor; prompt="Proxy port"; id=EPwDlgProxyPort; control=NUMBER_EDITOR { min=1; max=65535; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="A proxy such as WebOne fetches https pages for the Psion & keeps one connection open"; }; }
		};
	}

