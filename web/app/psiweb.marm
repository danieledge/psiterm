	$(EPOCTRGREL)/c32.lib \
	$(EPOCTRGREL)/esock.lib \
	$(EPOCTRGREL)/insock.lib

$(EPOCTRGREL)/psiweb.app : $(OBJECTSREL) $(LIBSREL)
	arm-pe-dlltool --as=arm-pe-as --output-def $(EPOCBLDREL)/psiweb.tmp.def $(OBJECTSREL) 
	perl -S deftool.pl $(EPOCBLDREL)/psiweb.tmp.def > $(EPOCBLDREL)/psiweb.def 
	arm-pe-ld -s -e _E32Dll --dll \
		--base-file "$(EPOCBLDREL)/psiweb.bas" \
		-o "$(EPOCBLDREL)/psiweb.app" $(EPOCTRGREL)/edll.o \
		$(OBJECTSREL) \
		 $(LIBSREL)
	arm-pe-dlltool --as=arm-pe-as --output-lib $(EPOCTRGREL)/psiweb.lib \
		--def $(EPOCBLDREL)/psiweb.def \
		--dllname psiweb[01000a7a].app \
		--output-exp psiweb.exp \
		--base-file $(EPOCBLDREL)/psiweb.bas \
		$(EPOCTRGREL)/edll.o 		$(OBJECTSREL)  $(LIBSREL)
	arm-pe-ld -s -e _E32Dll --dll \
		-Map $(EPOCTRGREL)/psiweb.map \
		-o $(EPOCBLDREL)/psiweb.app psiweb.exp \
		$(EPOCTRGREL)/edll.o \
$(OBJECTSREL) \
		 $(LIBSREL)
	wine $(EPOCROOT)/epoc32/tools/petran.exe $(EPOCBLDREL)/psiweb.app $@ \
		 -nocall -uid1 0x10000079 -uid2 0x1000006c -uid3 0x01000a7a
	rm -f "psiweb.exp"
	rm -f "$(EPOCBLDREL)/psiweb.app"

