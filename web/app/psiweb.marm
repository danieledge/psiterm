ERASE = rm -f

# EPOC DEFINITIONS

INCDIR  = -I /home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk//ptproj/psiweb/ -I- -I /home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk//ptproj/psiwebinc/ -I /home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk//ptproj/psitermssh/ -I /home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk//epoc32/include/libc/ -I /home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk//epoc32/include/

GCCFLAGS= -c -nostdinc -Wno-ctor-dtor-privacy -mcpu=arm710 -mapcs-32 \
		-mshort-load-bytes -msoft-float -O2 -fcheck-new -fvtable-thunks

GCCDEFS = -D__SYMBIAN32__ -D__PSISOFT32__ -D__GCC32__ -D__EPOC32__ -D__MARM__ -D__DLL__ $(USERDEFS)

EPOCBLDREL = $(EPOCROOT)/epoc32/build//home/daniel/www/psion/psion_cpp_sdk_linux/epoc_cpp_sdk/ptproj/marmd/rel
