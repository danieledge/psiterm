EPOCTRGUDEB = $(EPOCROOT)/epoc32/release/marm/udeb


GCCREL = arm-pe-gcc -s -fomit-frame-pointer $(GCCFLAGS) -DNDEBUG $(GCCDEFS)
GCCDEB = arm-pe-gcc -g $(GCCFLAGS) -D_DEBUG $(GCCDEFS)
GCCUREL = arm-pe-gcc -s -fomit-frame-pointer $(GCCFLAGS) -DNDEBUG -D_UNICODE $(GCCDEFS)
GCCUDEB = arm-pe-gcc -g $(GCCFLAGS) -D_DEBUG -D_UNICODE $(GCCDEFS)


# EPOC PSEUDOTARGETS

rel: \
	MAKEWORKREL \
	$(EPOCTRGREL)/psiweb.rsc \
	$(EPOCTRGREL)/psiweb.app

deb: \
	MAKEWORKDEB \
	$(EPOCTRGDEB)/psiweb.rsc \
	$(EPOCTRGDEB)/psiweb.app

urel: \
	MAKEWORKUREL \
	$(EPOCTRGUREL)/psiweb.rsc \
	$(EPOCTRGUREL)/psiweb.app

udeb: \
	MAKEWORKUDEB \
	$(EPOCTRGUDEB)/psiweb.rsc \
	$(EPOCTRGUDEB)/psiweb.app


clean: cleanrel cleandeb cleanurel cleanudeb

MAKEWORK : MAKEWORKREL MAKEWORKDEB MAKEWORKUREL MAKEWORKUDEB


