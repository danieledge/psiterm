	EPwDlgPictures,          // Preferences: pictures on every page (0.62)
	EPwDlgAuthWho,           // User name and password (Links phase 5)
	EPwDlgAuthRealm,
	EPwDlgAuthUser,
	EPwDlgAuthPass,
	EPwDlgText,              // Preferences > Text: sharp or scaled (docs/display.md)
	EPwDlgFavName,           // Add to favourites: Name
	EPwDlgFavUrl,            // ...and Address
