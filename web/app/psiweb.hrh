// PSIWEB.HRH - command and control ids for PsiWeb.app

enum TPwCommands
	{
	EPwCmdOpen = 0x1000,
	EPwCmdHome,
	EPwCmdReload,
	EPwCmdStop,
	EPwCmdBack,
	EPwCmdForward,
	EPwCmdTop,
	EPwCmdBottom,
	EPwCmdZoomIn,
	EPwCmdZoomOut,
	EPwCmdZoomNormal,
	EPwCmdImages,
	EPwCmdConnSettings,
	EPwCmdPrefs,
	EPwCmdPageInfo,
	EPwCmdRestart,
	EPwCmdAbout,
	EPwCmdUpdate,
	EPwCmdSendLog,           // Tools > Send log to server (0.71)
	EPwCmdHangup,
	EPwCmdConnect,           // File > Connect (as PsiTerm's)
	EPwCmdToggleToolbar,
	EPwCmdHelp,              // Tools > Help on PsiWeb
	EPwCmdReading,           // View > Reading mode (docs/display.md)
	// Favourites and History (0.69)
	EPwCmdAddFav,            // Favourites > Add to favourites... (Shift+Ctrl+D)
	EPwCmdOrganiseFav,       // Favourites > Organise favourites...
	EPwCmdFavMore,           // Favourites > More favourites...
	EPwCmdHistory,           // Go > History (the cascade's own id)
	EPwCmdHistoryFull,       // History > Full history...
	EPwCmdClearHistory,      // History > Clear history
	EPwCmdHistNone,          // History > (No history), dimmed
	EPwCmdFav0 = 0x1100,     // the favourites on the menu: 16 slots
	EPwCmdHist0 = 0x1120     // the History cascade's pages: 16 slots
	};

