// PSITERM.MMP
TARGET        psiterm.app
TARGETTYPE    app
UID           0x1000006c 0x01000A77
TARGETPATH    \system\apps\psiterm

PROJECT       ptproj
SUBPROJECT    psiterm

SOURCE        psiterm.cpp glyphs.cpp termsb.cpp
RESOURCE      psiterm.rss

USERINCLUDE   \ptproj\psiterm \ptproj\psiterm\vterm
SYSTEMINCLUDE \ptproj\psiterm\vterm \epoc32\include\libc \epoc32\include

LIBRARY       psivterm.lib
LIBRARY       euser.lib efsrv.lib apparc.lib apgrfx.lib cone.lib eikon.lib ws32.lib gdi.lib
LIBRARY       c32.lib bafl.lib estlib.lib etext.lib estor.lib fbscli.lib
