// Plain Ctrl+letter combinations all go to the remote system (Ctrl+C etc.),
// so PsiTerm's own shortcuts use Shift+Ctrl.
RESOURCE HOTKEYS r_pt_hotkeys
	{
	shift_control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=EPtCmdHangup; key='h'; },
