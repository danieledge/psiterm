// The standard toolbar: the program's name, four buttons for the pen, the
// clock. SSH to... (Disconnect while a session is up, as the built-in Email
// program's Open / Close mailbox), Snippets and Keys (both pop up a choice),
// and Zoom (cycles the sizes). The pictures come from PsiTerm.mbm
// (tools/mkicons.py): CPsiTermAppUi::ConstructL puts them on. View > Show
// toolbar (Shift+Ctrl+B) hides it and the terminal takes its 70 pixels.
RESOURCE TOOLBAR r_pt_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiTerm"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=EPtCmdTbConnect; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="SSH to"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPtCmdTbSnippets;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pt_snippets_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Send\nsnippet"; };
			},
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPtCmdTbKeys;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pt_keys_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Keys"; };
			},
		TBAR_BUTTON { id=EPtCmdZoomIn; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Zoom"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

