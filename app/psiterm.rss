// Shortcuts. In a terminal every plain Ctrl+letter must reach the remote
// system (Ctrl+C, Ctrl+D, Ctrl+Z...), so PsiTerm cannot use EIKON's Ctrl+
// shortcuts at all: its own are all Shift+Ctrl+letter, choosing the standard
// letter where one exists (E close, S SSH to = "save as", C copy, V paste,
// M zoom, K preferences, H help, A about) and the built-in Email program's for the
// connection (D = close mailbox, U = disconnect). Show toolbar is on
// Shift+Ctrl+B ("toolBar"): EIKON's Ctrl+T cannot be used, and Shift+Ctrl+T
// has typed Shift+Tab (Claude Code's switch mode) since 0.35. Snippets take
// the letters left over (see KSnippetKeys in psiterm.cpp).
RESOURCE HOTKEYS r_pt_hotkeys
	{
	shift_control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=EPtCmdSsh; key='s'; },
		HOTKEY { command=EPtCmdSshDisconnect; key='d'; },
		HOTKEY { command=EPtCmdHangup; key='u'; },
		HOTKEY { command=EPtCmdCopy; key='c'; },
		HOTKEY { command=EPtCmdPaste; key='v'; },
		HOTKEY { command=EPtCmdZoomOut; key='m'; },
		HOTKEY { command=EPtCmdAppearance; key='k'; },
		HOTKEY { command=EPtCmdKeyShiftTab; key='t'; },
		HOTKEY { command=EPtCmdToolbar; key='b'; },
		HOTKEY { command=EPtCmdScreenshot; key='p'; },
		HOTKEY { command=EPtCmdHelp; key='h'; },
		HOTKEY { command=EPtCmdAbout; key='a'; }
		};
	}

