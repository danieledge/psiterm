enum TPsiTermDialogButtons
	{
	EPtBidNew = 100,
	EPtBidEdit,
	EPtBidDelete,
	EPtBidImport,
	EPtBidShow,
	EPtBidUp,                // 0.74: the server's folder list
	EPtBidOpen,
	EPtBidXferDone,          // the progress window closes itself
	EPtBidGoto,              // 0.88: a tap on the sidebar's path
	EPtBidFavourites,        // the file view's favourite folders, one list per server: Favourite (in or out)
