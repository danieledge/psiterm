	EPtCmdTmuxPrefixB,
	EPtCmdTmuxPrefixA,
	EPtCmdAppearance,         // Tools > Preferences...
	EPtCmdLoginKey,
	EPtCmdInstallKey,

	// EIKON pass: View > Zoom in / Zoom out (cycle the font sizes) and the
	// Show status line tick box
	EPtCmdZoomIn,
	EPtCmdZoomOut,
	EPtCmdStatusLine,

	// the toolbar: View > Show toolbar (Shift+Ctrl+B), its first button (SSH
	// to..., or End SSH while a session is up) and its two pop-up buttons
	EPtCmdToolbar,
	EPtCmdTbConnect,
	EPtCmdTbSnippets,
	EPtCmdTbKeys,

	// 0.74: file transfer (SFTP) and the session log (ptxfer.cpp)
	EPtCmdSendFile,           // File > Send file...
	EPtCmdGetFile,            // File > Get file...
	EPtCmdLog,                // File > Log to file... (tick box)

	// 0.75: the toolbar's Files button (pops up Send file / Get file / Log
	// to file; it replaced Zoom - the sidebar has zoom icons)
	EPtCmdTbFiles,

	// display work (docs/display.md): View > Reading mode (tick box) and
	// Tools > Debug > Display calibration...
	EPtCmdReading,
	EPtCmdGreyCal,

	EPtCmdSnippet0 = 0x1400,  // ... EPtCmdSnippet0 + KMaxSnippets - 1: send snippet N
	EPtCmdHost0 = 0x1500      // ... + KMaxHosts - 1: connect to saved host N (welcome screen)
	};

