	EPtCmdZoom1,
	EPtCmdZoom2,
	EPtCmdZoom3,
	EPtCmdZoom4,

	EPtCmdUpdate,
	EPtCmdCharInfo,
	EPtCmdScreenshot,
	EPtCmdSendShots,
	EPtCmdUpdateServer,      // (0.70: no longer on a menu - Update PsiTerm... asks where from)
	EPtCmdBold,
	EPtCmdConnSettings,

	// 0.35: snippets, Claude Code keys, tmux, appearance
	EPtCmdSnippets,           // Snippets > Manage snippets...
	EPtCmdClaudeEsc,
	EPtCmdClaudeEscEsc,
	EPtCmdClaudeMode,
	EPtCmdClaudeClear,
	EPtCmdClaudeCompact,
	EPtCmdClaudeResume,
