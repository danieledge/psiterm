	};

// the file view's title band and sidebar: labels that draw themselves (ptxfer.cpp)
enum TPtCustomControls
	{
	EPtCtBrowsePart = 0x7600,
	EPtCtBrowseList          // the file view's list (a column list with no margins)
	};

// Connection settings > Test (0.74): the button, and the result dialog's lines
enum TPtLinkTest
	{
	EPtBidTest = 0x7400,
	EPtDlgTest1, EPtDlgTest2, EPtDlgTest3, EPtDlgTest4, EPtDlgTest5
	};

// Preferences > Screen greys... (0.84): the button, the same id in all
// three apps (ssh/psigreyui.cpp)
enum TPtGreyButton
	{
	EPtBidGreys = 0x7480
	};

// the Connection settings pages
enum TPtConnPages
	{
	EPtPageLink = 0x300,
	EPtPageProxy,
	EPtPageInternet          // (link keep-up) its own page: Network has no room for two more lines
	};
