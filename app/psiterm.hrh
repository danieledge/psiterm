// PSITERM.HRH - command IDs shared by the resource file and the C++ code

enum TPsiTermCommands
	{
	EPtCmdSsh = 0x1000,
	EPtCmdSshDisconnect,
	EPtCmdSpeedTest,
	EPtCmdDial,
	EPtCmdHangup,
	EPtCmdConnect,
	EPtCmdSendSize,
	EPtCmdReset,
	EPtCmdAbout,
	EPtCmdHelp,           // Tools > Help on PsiTerm

	EPtCmdKeyEsc,
	EPtCmdKeyTab,
	EPtCmdKeyShiftTab,
	EPtCmdKeyCtrlC,
	EPtCmdKeyCtrlD,
	EPtCmdKeyCtrlZ,
	EPtCmdKeyCtrlL,
	EPtCmdKeyCtrlR,
	EPtCmdKeyCtrlA,
	EPtCmdKeyCtrlBackslash,
	EPtCmdKeyInsert,

	EPtCmdF1,
	EPtCmdF2,
	EPtCmdF3,
	EPtCmdF4,
	EPtCmdF5,
	EPtCmdF6,
	EPtCmdF7,
	EPtCmdF8,
	EPtCmdF9,
	EPtCmdF10,
	EPtCmdF11,
	EPtCmdF12,

	EPtCmdBaud9600,
	EPtCmdBaud19200,
	EPtCmdBaud38400,
	EPtCmdBaud57600,
	EPtCmdBaud115200,

	EPtCmdFlowNone,
	EPtCmdFlowRtsCts,


	EPtCmdSerialInfo,

	EPtCmdLinkModem,
	EPtCmdLinkPpp,

	EPtCmdCopy,
	EPtCmdPaste,
	EPtCmdSelectScreen,
	EPtCmdScrollUp,
	EPtCmdScrollDown,
	EPtCmdScrollEnd,

	EPtCmdZoom0,          // five zoom levels, smallest first
	EPtCmdZoom1,
	EPtCmdZoom2,
	EPtCmdZoom3,
	EPtCmdZoom4,

	EPtCmdUpdate,
	EPtCmdSendLog,           // 0.89: Tools > Debug > Send log to server
	EPtCmdCharInfo,
	EPtCmdScreenshot,
	EPtCmdUpdateServer,      // (0.70: no longer on a menu - Update PsiTerm... asks where from)
	EPtCmdBold,
	EPtCmdConnSettings,

	// 0.35: snippets, tmux, appearance (0.86: Claude Code keys are now snippets)
	EPtCmdSnippets,           // Snippets > Manage snippets...
	EPtCmdTmuxNew,
	EPtCmdTmuxNext,
	EPtCmdTmuxPrev,
	EPtCmdTmuxChoose,
	EPtCmdTmuxSplitH,
	EPtCmdTmuxSplitV,
	EPtCmdTmuxPane,
	EPtCmdTmuxZoom,
	EPtCmdTmuxCopy,
	EPtCmdTmuxRename,
	EPtCmdTmuxDetach,
	EPtCmdTmuxMouse,
	EPtCmdTmuxTabs,
	EPtCmdCheckTabs,
	EPtCmdTmuxPrefixB,
	EPtCmdTmuxPrefixA,
	EPtCmdAppearance,         // Tools > Preferences...
	EPtCmdLoginKey,
	EPtCmdInstallKey,

	// EIKON pass: View > Zoom in / Zoom out (cycle the font sizes) and the
	// Show status line tick box
	EPtCmdZoomIn,
	EPtCmdZoomOut,
	EPtCmdStatusLine,

	// the toolbar: View > Show toolbar (Shift+Ctrl+B), its first button (SSH
	// to..., or End SSH while a session is up) and its two pop-up buttons
	EPtCmdToolbar,
	EPtCmdTbConnect,
	EPtCmdTbSnippets,
	EPtCmdTbKeys,

	// 0.74: file transfer (SFTP) and the session log (ptxfer.cpp)
	EPtCmdSendFile,           // File > Send file...
	EPtCmdGetFile,            // File > Get file...
	EPtCmdLog,                // File > Log to file... (tick box)

	// 0.75: the toolbar's Files button (pops up Send file / Get file / Log
	// to file; it replaced Zoom - the sidebar has zoom icons)
	EPtCmdTbFiles,

	// display work (docs/display.md): View > Reading mode (tick box)
	EPtCmdReading,
	// 0.96: View > Font > Other font... (any typeface the Psion has)
	EPtCmdFontOther,

	// 0.91: the file view (Get file / Send file), a view of the program's
	// own with its own menus, shortcuts and toolbar (ptxfer.cpp)
	EPtCmdBrOpen,             // File > Open (the highlighted folder; Enter)
	EPtCmdBrAct,              // File > Get file... / Send here (the toolbar's third button)
	EPtCmdBrUp,               // File > Up a folder (Ctrl+U, Backspace)
	EPtCmdBrGoto,             // File > Go to folder... (Ctrl+G)
	EPtCmdBrClose,            // File > Close (Ctrl+E, Esc): back to the terminal
	EPtCmdBrFavourite,        // Favourites > Favourite folder (Ctrl+F, tick box)
	EPtCmdBrLast = EPtCmdBrFavourite,
	EPtCmdKeepLog,            // 0.97: Tools > Debug > Keep a log (tick box; off as standard)

	EPtCmdBrFav0 = 0x1380,    // ... + 7: go to favourite N (the Favourites menu)
	EPtCmdSnippet0 = 0x1400,  // ... EPtCmdSnippet0 + KMaxSnippets - 1: send snippet N
	EPtCmdHost0 = 0x1500      // ... + KMaxHosts - 1: connect to saved host N (welcome screen)
	};

