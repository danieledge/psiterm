# build output
/build/
*.o
*.obj
*.lib
*.map
*.marm
*.rpp
ssh/obj/
ssh/hobj/
ssh/psissh-host
ssh/emu/*.pe
ssh/test/gf/gftest
pkg/psiterm.app
pkg/psiterm.rsc
pkg/psiterm.mbm
pkg/psissh.exe
pkg/psihold.exe
pkg/STDLIB.SIS
# the Terminus font and its licence come from core/pkg at build time
pkg/psiterm.gdr
pkg/terminus-licence.txt
__pycache__/
*.pyc

# release signing key: never commit
*.key
!ssh/db/**/*.key
!ssh/test/update-test.key
signing/

# local debugging / device data
*.psi
upload-*.bin
screenshots/
!docs/screenshots/
known_hosts
*seed*
!ssh/db/src/dbrandom.c

# editors / OS
.DS_Store
*~
*.swp
.claude/

# ---- kept out of this public repo ----------------------------------------
# local additions: the program's own emulator tests go in test/emu/; other
# local builds in tools/docker/psibuild.local (run by core/tools/docker/psibuild all)
/tools/docker/psibuild.local
# packages other than the released apps', and the local-only combined suite
# (only the three released apps' packages are published: PsiMail's and
# PsiWeb's updaters read this repository's dist/ too)
dist/*.sis
!dist/PsiTerm.sis
!dist/PsiMail.sis
!dist/PsiWeb.sis
# core dumps (qemu-user and others; core/ itself is the psion-core submodule)
*.core
core.[0-9]*
# local headers, logs, environment and PsiProxy's own config
*_local.h
*_local.*
*.log
*.log.old
.env
.env.*
!.env.example
# WireGuard client configs and keys: they stay on your machine and the device
wg*.conf
*wireguard*.conf
*.wg
wg-*.txt

# Claude Code's local notes
CLAUDE.local.md
