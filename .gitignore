# ---- kept out of this public repo ----------------------------------------
# local additions: emulator tests and card makers (tools/emu/local/), and
# other projects checked out here (list those in .git/info/exclude)
/tools/emu/local/
/tools/docker/psibuild.local
# packages other than the released apps', and the local-only combined suite
# (only the three released apps' packages are published)
dist/*.sis
!dist/PsiTerm.sis
!dist/PsiMail.sis
!dist/PsiWeb.sis
# core dumps (qemu-user and others)
*.core
core
core.[0-9]*
# local headers, logs, environment and PsiProxy's own config
*_local.h
*_local.*
*.log
*.log.old
!experimental/kernel/results/*.log
.env
.env.*
!.env.example
proxy/psiproxy.env
proxy/*.secret
# WireGuard client configs and keys: they stay on your machine and the device
wg*.conf
*wireguard*.conf
*.wg
wg-*.txt

# Claude Code's local notes
CLAUDE.local.md
