	titles=
		{
		MENU_TITLE { menu_pane=r_pskt_file_menu; txt="File"; },
		MENU_TITLE { menu_pane=r_pskt_read_menu; txt="Read"; },
		MENU_TITLE { menu_pane=r_pskt_write_menu; txt="Write"; }
