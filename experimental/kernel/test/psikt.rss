RESOURCE EIK_APP_INFO { menubar=r_pskt_menubar; hotkeys=r_pskt_hotkeys; }
RESOURCE HOTKEYS r_pskt_hotkeys { control= { HOTKEY { command=EEikCmdExit; key='e'; } }; }
RESOURCE MENU_BAR r_pskt_menubar
