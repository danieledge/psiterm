; PsiCast 0.10 installer for Psion Series 5mx (EPOC R5)
; PsiCast.app: the state of the sharing, the commands, the settings.
; psicast.exe: reads the screen, sends it to the Atom, injects the viewer's input.
; psihold.exe: holds the Psion Internet connection up after use ("Stay connected", ssh/psihold.cpp)
&EN
; Two-digit versions (as the other programs): the EPOC installer compares
; major.minor only.
#{"PsiCast"},(0x01000A92),0,10,0
"psicast.app"-"!:\System\Apps\PsiCast\PsiCast.app"
"psicast.rsc"-"!:\System\Apps\PsiCast\PsiCast.rsc"
"psicast.aif"-"!:\System\Apps\PsiCast\PsiCast.aif"
"psicast.mbm"-"!:\System\Apps\PsiCast\PsiCast.mbm"
"psicast.exe"-"!:\System\Apps\PsiCast\psicast.exe"
"psihold.exe"-"!:\System\Apps\PsiCast\psihold.exe"
; PsiCast's own files (settings, the log): not installed, kept across
; upgrades, removed with the program (makesis FN)
""-"C:\System\Apps\PsiCast\PsiCast.ini",FN
""-"!:\System\Apps\PsiCast\psicast.log",FN
""-"!:\System\Apps\PsiCast\psicast.old",FN
; the EPOC C library (ESTLIB.DLL), which the engine needs and the 5mx ROM lacks
@"STDLIB.SIS",(0x100002c3)
