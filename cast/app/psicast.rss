// The toolbar: the name, four buttons, the clock. Share stays pressed in
// while the screen is shared (tap it again to stop), Pause while paused,
// Control while the viewer may tap and type. Back goes to the
// program to be shown. The pictures come from PsiCast.mbm
// (cast/pkg/mktbar.py), put on by CCsAppUi::ToolbarPicturesL.
RESOURCE TOOLBAR r_cs_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiCast"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=ECsCmdShareButton; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Share"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ECsCmdPause; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Pause"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ECsCmdControl; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Control"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ECsCmdPrevious; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Back"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// Shortcuts: EIKON's standard letters for the standard commands (Ctrl+E
// close, Ctrl+M / Shift+Ctrl+M zoom, Ctrl+T toolbar, Ctrl+K preferences,
// Shift+Ctrl+H help, Shift+Ctrl+A about), Ctrl+U to disconnect from the
// Internet as in the Email program, and free shifted letters for PsiCast's
// own: G go (start sharing), E end (stop sharing), W wait (pause; while
// sharing it works in every program), R remote control, Y back to the
// program before.
RESOURCE HOTKEYS r_cs_hotkeys
	{
	control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=ECsCmdZoomIn; key='m'; },
		HOTKEY { command=ECsCmdToolbar; key='t'; },
		HOTKEY { command=ECsCmdPrefs; key='k'; },
		HOTKEY { command=ECsCmdDisconnect; key='u'; }
		};
	shift_control=
		{
		HOTKEY { command=ECsCmdStart; key='g'; },
		HOTKEY { command=ECsCmdStop; key='e'; },
		HOTKEY { command=ECsCmdPause; key='w'; },
		HOTKEY { command=ECsCmdControl; key='r'; },
		HOTKEY { command=ECsCmdPrevious; key='y'; },
		HOTKEY { command=ECsCmdZoomOut; key='m'; },
		HOTKEY { command=ECsCmdHelp; key='h'; },
		HOTKEY { command=ECsCmdAbout; key='a'; }
		};
	}

