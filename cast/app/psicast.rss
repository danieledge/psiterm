	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="Highest update rate"; id=ECsDlgRate;
			control=CHOICELIST { array_id=r_cs_rate_array; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="Fewer updates save the batteries; the screen still shows every change"; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Allow control from the viewer"; id=ECsDlgControl;
			control=CHOICELIST { array_id=r_cs_noyes_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Stop sharing when the battery is low"; id=ECsDlgBattery;
			control=CHOICELIST { array_id=r_cs_noyes_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="When PsiCast closes"; id=ECsDlgOnClose;
			control=CHOICELIST { array_id=r_cs_onclose_array; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="Connects through the Atom, the way Connection settings say"; }; }
		};
