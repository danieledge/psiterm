// the standard toolbar, laid out as the built-in Email program has it: New,
// Reply/f'ward (both pop up a choice), Check mail, and Delete (in a list) or
// Close (reading a message: back to the list), then the clock.
// (The pictures come from PsiMail.mbm: CPmAppUi::ConstructL puts them on.)
RESOURCE TOOLBAR r_pm_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiMail"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPmCmdNewPopup;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pm_new_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="New"; };
			},
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPmCmdReplyPopup;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pm_reply_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Reply/\nf'ward"; };
			},
		TBAR_BUTTON { id=EPmCmdSendRecv; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Check\nmail"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPmCmdTool4; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Delete"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// the shortcuts: EIKON's standard ones for standard commands (Ctrl+E close,
// Ctrl+N create new, Ctrl+D delete, Ctrl+F find, Ctrl+G go to, Ctrl+K
// preferences, Ctrl+M zoom, Ctrl+Q switch view, Ctrl+T toolbar, Shift+Ctrl+A
// about), then the built-in Email program's (Shift+Ctrl+C check mail, Ctrl+U
// disconnect, Ctrl+X move, Shift+Ctrl+L folders, Shift+Ctrl+Q status,
// Shift+Ctrl+B sort), then free shifted keys for the rest. The same keys
// serve both menu bars (the mail's and the calendar's).
RESOURCE HOTKEYS r_pm_hotkeys
	{
	control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=EPmCmdNew; key='n'; },
		HOTKEY { command=EPmCmdReply; key='r'; },
		HOTKEY { command=EPmCmdForward; key='w'; },
		HOTKEY { command=EPmCmdDelete; key='d'; },
		HOTKEY { command=EPmCmdMove; key='x'; },
		HOTKEY { command=EPmCmdHangup; key='u'; },
		HOTKEY { command=EPmCmdZoomIn; key='m'; },
		HOTKEY { command=EPmCmdToggleToolbar; key='t'; },
		HOTKEY { command=EPmCmdPrefs; key='k'; },
		HOTKEY { command=EPmCmdSaveAttach; key='s'; },
		HOTKEY { command=EPmCmdFolders; key='g'; },
		HOTKEY { command=EPmCmdInbox; key='i'; },
		HOTKEY { command=EPmCmdRefresh; key='y'; },
		HOTKEY { command=EPmCmdSearch; key='f'; },
		HOTKEY { command=EPmCmdOutbox; key='b'; },
		HOTKEY { command=EPmCmdMonth; key='q'; },
		HOTKEY { command=EPmCmdUndo; key='z'; },
		HOTKEY { command=EPmCmdPrint; key='p'; }
		};
	shift_control=
		{
		HOTKEY { command=EPmCmdSendRecv; key='c'; },
		HOTKEY { command=EPmCmdReplyAll; key='r'; },
		HOTKEY { command=EPmCmdOffline; key='w'; },
		HOTKEY { command=EPmCmdArchive; key='e'; },
		HOTKEY { command=EPmCmdOlder; key='g'; },
		HOTKEY { command=EPmCmdZoomOut; key='m'; },
		HOTKEY { command=EPmCmdToggleTitle; key='t'; },
		HOTKEY { command=EPmCmdToggleFolders; key='l'; },
		HOTKEY { command=EPmCmdStatusInfo; key='q'; },
		HOTKEY { command=EPmCmdSort; key='b'; },
		HOTKEY { command=EPmCmdAbout; key='a'; },
		HOTKEY { command=EPmCmdShowCalendar; key='n'; },
		HOTKEY { command=EPmCmdCalendar; key='y'; },
		HOTKEY { command=EPmCmdUnread; key='u'; },
		HOTKEY { command=EPmCmdFlag; key='f'; },
		HOTKEY { command=EPmCmdToday; key='d'; },
		HOTKEY { command=EPmCmdHelp; key='h'; },
		HOTKEY { command=EPmCmdPrintSetup; key='p'; },
		HOTKEY { command=EPmCmdPrintPreview; key='v'; }
		};
