// PSIMAIL.MMP - PsiMail.app (the engine, psimail.exe, is built by ../Makefile)
TARGET        psimail.app
TARGETTYPE    app
UID           0x1000006c 0x01000A7C
TARGETPATH    \system\apps\psimail

PROJECT       ptproj
SUBPROJECT    psimail

SOURCE        psimail.cpp pmcal.cpp pmcalview.cpp pmwrite.cpp pmnative.cpp pmcontacts.cpp pmhelp.cpp pmpict.cpp
SOURCE        pmundo.cpp pmauto.cpp pmprint.cpp
SOURCE        pmstore.cpp pminvite.cpp pmvcard.cpp pmsaveword.cpp
SOURCE        pmrecover.cpp pmwebpic.cpp
SOURCE        pmstatus.cpp pmheader.cpp
SUBPROJECT    psimailinc\ui
SOURCE        pmquote.cpp pmcalmodel.cpp
SUBPROJECT    psitermssh
SOURCE        pglinktest.cpp
SUBPROJECT    psimail
RESOURCE      psimail.rss

USERINCLUDE   \ptproj\psimail \ptproj\psimailinc\ui
SYSTEMINCLUDE \ptproj\psimailinc \ptproj\psitermssh \epoc32\include\libc \epoc32\include

LIBRARY       euser.lib efsrv.lib apparc.lib cone.lib eikon.lib ws32.lib gdi.lib
LIBRARY       fbscli.lib bafl.lib apgrfx.lib etext.lib agnmodel.lib estor.lib form.lib nifman.lib cntmodel.lib
LIBRARY       c32.lib esock.lib insock.lib
LIBRARY       wpeng.lib print.lib
LIBRARY       clock.lib
