; PsiMail 0.69 installer for Psion Series 5mx (EPOC R5)
; PsiMail.app: screen, menus, settings.  psimail.exe: the mail engine.
&EN
#{"PsiMail"},(0x01000A7C),0,69,0
"psimail.app"-"!:\System\Apps\PsiMail\PsiMail.app"
"psimail.rsc"-"!:\System\Apps\PsiMail\PsiMail.rsc"
"psimail.mbm"-"!:\System\Apps\PsiMail\PsiMail.mbm"
"psimail.aif"-"!:\System\Apps\PsiMail\PsiMail.aif"
"psimail.exe"-"!:\System\Apps\PsiMail\psimail.exe"
; the settings PsiMail writes: kept over an upgrade, removed with the program
; (the mail itself, in \PsiMail on the memory disk or the internal disk, stays)
""-"C:\System\Apps\PsiMail\PsiMail.ini",FN
""-"C:\System\Apps\PsiMail\Calendar.ini",FN
""-"C:\System\Apps\PsiMail\Update.ini",FN
; the EPOC C library (ESTLIB.DLL), which the engine needs and the 5mx ROM lacks
@"STDLIB.SIS",(0x100002c3)
