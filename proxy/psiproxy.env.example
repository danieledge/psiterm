# PsiProxy settings. Copy to psiproxy.env (beside the proxy) or to
# ~/.config/psiproxy/psiproxy.env, or point PSIPROXY_CONFIG at a file.
# The real environment overrides anything here. Do not put secrets in it.

# Where to listen. 127.0.0.1 = this computer only. To let a Psion on your LAN
# in, use this computer's LAN address (or 0.0.0.0 for every interface).
PSIPROXY_ADDR=127.0.0.1
PSIPROXY_PORT=8081

# Who may connect (comma-separated CIDRs). Unset: loopback only when bound to
# loopback, else loopback + RFC 1918 + link-local + IPv6 ULA.
#PSIPROXY_ALLOW=127.0.0.1/32,192.168.1.0/24

# Fetch private/loopback/link-local destinations too (0 = refuse, 403).
PSIPROXY_ALLOW_PRIVATE=0

# Headless-browser rendering: auto (on only if ALLOW_PRIVATE=1), 1, or 0.
PSIPROXY_JS_RENDER=auto

# Largest request body from a client, in bytes.
PSIPROXY_MAX_BODY=4194304

# The apps' "Send log to server" button.
PSIPROXY_PUTLOG=1
#PSIPROXY_PUTLOG_TOKEN=
PSIPROXY_LOG_DIR=~/psion-logs
PSIPROXY_LOG_MAX_MB=50
PSIPROXY_LOG_MAX_FILES=200

# Plug-ins (README, Plug-ins): auto (the modules in the local list), none,
# or a list of modules.
PSIPROXY_PLUGINS=auto
#PSIPROXY_PLUGINS_FILE=plugins.local.json
#PSIPROXY_PLUGIN_PATH=

# Runtime state (toggles, control socket, rotating log).
#PSIPROXY_STATE_DIR=~/.config/psiproxy
