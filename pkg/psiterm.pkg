; PsiTerm installer for the Psion Series 5mx, Series 7 and netBook (EPOC R5)
; PsiTerm: libvterm terminal.  psissh.exe: Dropbear SSH client.
; psihold.exe: holds the Psion Internet connection up after use ("Stay connected", ssh/psihold.cpp)
&EN
#{"PsiTerm"},(0x01000A77),1,18,0
"psiterm.app"-"!:\System\Apps\PsiTerm\PsiTerm.app"
"psiterm.rsc"-"!:\System\Apps\PsiTerm\PsiTerm.rsc"
"psiterm.mbm"-"!:\System\Apps\PsiTerm\PsiTerm.mbm"
"psissh.exe"-"!:\System\Apps\PsiTerm\psissh.exe"
"psihold.exe"-"!:\System\Apps\PsiTerm\psihold.exe"
"psiterm.aif"-"!:\System\Apps\PsiTerm\PsiTerm.aif"
"psiterm.gdr"-"!:\System\Apps\PsiTerm\PsiTerm.gdr"
"terminus-licence.txt"-"!:\System\Apps\PsiTerm\Terminus-licence.txt"
"font-licences.txt"-"!:\System\Apps\PsiTerm\Font-licences.txt"
; PsiTerm's own files (settings, saved servers, snippets, the key list, the
; random seed, the SSH known_hosts): not installed, kept across upgrades,
; removed with the program so nothing is left behind (makesis FN)
""-"C:\System\Apps\PsiTerm\PsiTerm.ini",FN
""-"C:\System\Apps\PsiTerm\Hosts.dat",FN
""-"C:\System\Apps\PsiTerm\Snippets.dat",FN
""-"C:\System\Apps\PsiTerm\Keys.dat",FN
""-"C:\System\Apps\PsiTerm\ssh_seed.bin",FN
""-"C:\System\Apps\PsiTerm\.ssh\known_hosts",FN
; (1.18) the rest of its own files, and the SSH keys themselves (Keys\k<n>.key,
; .pub and .fp; Keys.dat above is only their list): removing PsiTerm takes
; its private keys with it. A key's number is one more than the highest in
; use, so 1 to 20 covers every list of up to 10 keys made in turn.
""-"C:\System\Apps\PsiTerm\Tmux.ini",FN
""-"C:\System\Apps\PsiTerm\Log.ini",FN
""-"C:\System\Apps\PsiTerm\Folders.dat",FN
""-"C:\System\Apps\PsiTerm\History.dat",FN
""-"C:\System\Apps\PsiTerm\History.tmp",FN
""-"C:\System\Apps\PsiTerm\Edited.dat",FN
""-"C:\System\Apps\PsiTerm\Edit.tmp",FN
""-"C:\System\Apps\PsiTerm\id_ed25519",FN
""-"C:\System\Apps\PsiTerm\Keys\k1.key",FN
""-"C:\System\Apps\PsiTerm\Keys\k1.pub",FN
""-"C:\System\Apps\PsiTerm\Keys\k1.fp",FN
""-"C:\System\Apps\PsiTerm\Keys\k2.key",FN
